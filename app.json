{
  "expo": {
    "name": "TransPriv 1.0",
    "slug": "transpriv-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.transpriv.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Esta app utiliza Face ID para autenticación biométrica.",
        "NSLocationWhenInUseUsageDescription": "Esta app necesita acceso a tu ubicación para mostrar las rutas de los camiones.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Esta app necesita acceso a tu ubicación para mostrar las rutas de los camiones."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.transpriv.app",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "RECEIVE_BOOT_COMPLETED",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#ffffff"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Esta app utiliza Face ID para autenticación biométrica."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Esta app necesita acceso a tu ubicación para mostrar las rutas de los camiones."
        }
      ],
      [
        "./plugins/withReactNativeMaps.js",
        {
          "googleMapsApiKey": "TU_API_KEY"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "TU_PROJECT_ID"
      }
    }
  }
}